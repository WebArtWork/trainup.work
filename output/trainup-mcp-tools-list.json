      {
        "name": "upsert_day_exercise",
        "description": "Adds an exercise to a plan day, or updates its prescription if already there. Refuses unsuitable exercises, past or completed days, duplicates, more than 8 exercises and days over the session time budget.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "dayIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "From get_active_plan"
            },
            "exerciseId": {
              "type": "string"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Defaults to the exercise's own default"
            },
            "repsMin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Reps-based exercises only"
            },
            "repsMax": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Reps-based exercises only"
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 600,
              "description": "Time-based exercises only"
            },
            "restSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "targetRpe": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Target exertion, default 7"
            }
