rules_version = '2';

// Data model and security requirements: README.md sections 10 and 12.
// The trusted server (Admin SDK) bypasses these rules; they only constrain client access.
service cloud.firestore {
	match /databases/{database}/documents {
		function signedIn() {
			return request.auth != null;
		}

		function isOwner(uid) {
			return signedIn() && request.auth.uid == uid;
		}

		function isAdmin() {
			return signedIn() && request.auth.token.admin == true;
		}

		// Exercise catalog: signed-in users see published entries; only admins publish or edit.
		match /exercises/{exerciseId} {
			allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
			allow write: if isAdmin();
		}

		match /users/{uid} {
			allow read, write: if isOwner(uid);

			// User-configured facts and personal routines: owner-managed.
			match /trainingSetups/{setupId} {
				allow read, write: if isOwner(uid);
			}

			match /limitations/{limitationId} {
				allow read, write: if isOwner(uid);
			}

			match /sessions/{sessionId} {
				allow read, write: if isOwner(uid);
			}

			match /todos/{todoId} {
				allow read, write: if isOwner(uid);
			}

			match /reminders/{reminderId} {
				allow read, write: if isOwner(uid);
			}

			// Plans are generated and validated on the trusted server; clients only read them.
			match /plans/{planId} {
				allow read: if isOwner(uid);
				allow write: if false;
			}

			// AI connections hold secret references managed by the server; clients only read status.
			match /aiConnections/{connectionId} {
				allow read: if isOwner(uid);
				allow write: if false;
			}
		}

		// Everything else is denied by default.
	}
}
